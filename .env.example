# Required env vars (must be set — app fails fast on missing values)
DATABASE_URL=postgresql+asyncpg://sir_user:sir_password@localhost:5432/sir_assist
CORS_ORIGIN=http://localhost:3000

# Optional (have safe defaults)
APP_ENV=development
DB_QUERY_TIMEOUT_SECONDS=10
MAX_REQUEST_BODY_BYTES=1048576
DUPLICATE_WINDOW_MINUTES=60
